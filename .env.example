# Runtime connection. Add pgbouncer=true when using a transaction pooler.
DATABASE_URL="postgresql://vault_user:replace_me@localhost:5432/centralized_secret_vault?schema=public"
# Unpooled connection for Prisma migrations and schema operations.
DATABASE_URL_UNPOOLED="postgresql://vault_user:replace_me@localhost:5432/centralized_secret_vault?schema=public"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
AUDIT_HMAC_KEY=""
# 32 random bytes encoded as base64. Local development only.
DEV_KEK_BASE64=""
# Vercel runtime only: 32 random bytes encoded as base64. Use a different key than AUDIT_HMAC_KEY.
VAULT_KEK_BASE64=""
NODE_ENV="development"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
